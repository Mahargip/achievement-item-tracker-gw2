<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AchievementItemTracker</AssemblyName>
    <RootNamespace>AchievementItemTracker</RootNamespace>
    <Nullable>enable</Nullable>
    <BlishHudModulesDir>$(USERPROFILE)\Documents\Guild Wars 2\addons\blishhud\modules</BlishHudModulesDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlishHUD" Version="1.2.0" ExcludeAssets="runtime;contentFiles;analyzers" />
    <PackageReference Include="System.ComponentModel.Composition" Version="6.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Built-in BlishHUD packaging target will output .bhm to both OutDir and modules folder -->
    <BlishHudAddonsDir>$(USERPROFILE)\Documents\Guild Wars 2\addons\blishhud\modules\</BlishHudAddonsDir>
  </PropertyGroup>

  <!-- Auto-deploy .bhm to Blish HUD modules directory after build -->
  <Target Name="DeployBhm" AfterTargets="BuildBlishHUDModule" Condition="Exists('$(BlishHudAddonsDir)')">
    <Copy SourceFiles="$(BlishHUDModuleFilePath)" DestinationFolder="$(BlishHudAddonsDir)" />
    <Message Importance="High" Text="[AchievementItemTracker] Deployed $(BlishHUDModuleFileName).bhm to $(BlishHudAddonsDir)" />
  </Target>

</Project>
